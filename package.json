{
  "name": "ortodont-rashid-site",
  "version": "1.0.0",
  "private": true,
  "description": "Сайт ортодонтической клиники Ortodont Rashid (демо)",
  "site": {
    "slug": "ortodont-rashid",
    "title": "Ortodont Rashid",
    "url": "https://stomatology-ideal.ru",
    "pages": [
      "/",
      "/card/"
    ]
  },
  "scripts": {
    "start": "node tools/serve.js src",
    "build": "node tools/build.js",
