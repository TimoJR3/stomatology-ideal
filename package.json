  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "html-validate": "11.21.1",
    "qrcode": "1.5.4",
    "stylelint": "18.0.0",
    "stylelint-config-recommended": "19.0.0"
  }
}
